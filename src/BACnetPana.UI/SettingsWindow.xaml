<Window x:Class="bacneTPana.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen - Ampel-Schwellwerte"
        Height="800"
        Width="640"
        MinHeight="760"
        Background="#F0F0F0"
        FontSize="12"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <DockPanel LastChildFill="True">
        <!-- Title Bar -->
        <Grid DockPanel.Dock="Top" Background="#2D2D2D" Height="80">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="15">
                <TextBlock Text="⚙️ Ampel-Schwellwerte - COV und ReadProperty"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"/>
                <TextBlock Text="Konfigurieren Sie die Ampel-Schwellwerte für Change of Value Notifications und ReadProperty Anfragen"
                           Foreground="#CCC"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Footer with Buttons -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1,1,0,0" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetButton"
                        Content="Zurücksetzen"
                        Padding="15,8"
                        Background="#6264A7"
                        Foreground="White"
                        Click="ResetButton_Click"
                        MinWidth="100"
                        Margin="0,0,10,0"/>

                <Button x:Name="CancelButton"
                        Content="Abbrechen"
                        Padding="15,8"
                        Background="#A4A4A4"
                        Foreground="White"
                        Click="CancelButton_Click"
                        MinWidth="100"
                        Margin="0,0,10,0"/>

                <Button x:Name="SaveButton"
                        Content="Speichern"
                        Padding="15,8"
                        Background="#28A745"
                        Foreground="White"
                        Click="SaveButton_Click"
                        MinWidth="100"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <!-- Info Box -->
            <Border Grid.Row="0" Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Ampel-Bewertung" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🟢 Gut:" Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="0 - [Grüner Schwellwert] COV/min" Foreground="#555"/>

                        <TextBlock Grid.Column="2" Text="🟡 OK:" Foreground="#F57F17" FontWeight="Bold" Margin="12,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="> Grüner Schwellwert bis [Gelber Schwellwert] COV/min" Foreground="#555"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🟠 Schlecht:" Foreground="#FF9800" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="> Gelber Schwellwert bis [Roter Schwellwert] COV/min" Foreground="#555"/>

                        <TextBlock Grid.Column="2" Text="🔴 Kritisch:" Foreground="#C62828" FontWeight="Bold" Margin="12,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="> Roter Schwellwert" Foreground="#555"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Threshold Configuration -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="COV Schwellwert-Einstellungen" FontWeight="Bold" FontSize="13" Foreground="#333" Margin="0,0,0,15"/>

                    <!-- Green Threshold -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock FontWeight="Bold" Foreground="#28A745"><Run Text="🟢 Schwellwert Gut"/><Run Language="de-de"/></TextBlock>
                                <TextBlock Text="Maximal für Gut-Status" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Slider Grid.Column="1" Grid.Row="0"
                                x:Name="GreenThresholdSlider"
                                Minimum="0" Maximum="50"
                                Value="2"
                                VerticalAlignment="Center"
                                Margin="15,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   x:Name="GreenThresholdValueLabel"
                                   Text="2"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#28A745"
                                   TextAlignment="Right"/>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                   Text="Schwellwert darf nicht größer als Gelber Schwellwert sein"
                                   FontSize="10" Foreground="#999" FontStyle="Italic" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- Yellow Threshold -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="🟡 Schwellwert OK" FontWeight="Bold" Foreground="#FFC107"/>
                            <TextBlock Text="Maximal für OK-Status" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Slider Grid.Column="1" Grid.Row="0"
                                x:Name="YellowThresholdSlider"
                                Minimum="0" Maximum="50"
                                Value="10"
                                VerticalAlignment="Center"
                                Margin="15,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   x:Name="YellowThresholdValueLabel"
                                   Text="10"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFC107"
                                   TextAlignment="Right"/>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                   Text="Schwellwert muss größer als Grüner Schwellwert sein und darf nicht größer als Roter Schwellwert sein"
                                   FontSize="10" Foreground="#999" FontStyle="Italic" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- Red Threshold -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="🟠 Schwellwert Schlecht" FontWeight="Bold" Foreground="#FF9800"/>
                            <TextBlock Text="Maximal für Schlecht-Status" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Slider Grid.Column="1" Grid.Row="0"
                                x:Name="RedThresholdSlider"
                                Minimum="0" Maximum="100"
                                Value="30"
                                VerticalAlignment="Center"
                                Margin="15,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   x:Name="RedThresholdValueLabel"
                                   Text="30"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FF9800"
                                   TextAlignment="Right"/>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                   Text="Schwellwert muss größer als Gelber Schwellwert sein"
                                   FontSize="10" Foreground="#999" FontStyle="Italic" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ReadProperty Threshold Configuration -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="ReadProperty Anfragen - Schwellwert-Einstellungen" FontWeight="Bold" FontSize="13" Foreground="#333" Margin="0,0,0,15"/>

                    <!-- ReadProperty Green Threshold -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="🟢 Schwellwert Gut" FontWeight="Bold" Foreground="#28A745"/>
                            <TextBlock Text="Maximal für Gut-Status" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Slider Grid.Column="1" Grid.Row="0"
                                x:Name="ReadPropertyGreenThresholdSlider"
                                Minimum="0" Maximum="100"
                                Value="6"
                                VerticalAlignment="Center"
                                Margin="15,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   x:Name="ReadPropertyGreenThresholdValueLabel"
                                   Text="6"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#28A745"
                                   TextAlignment="Right"/>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                   Text="Schwellwert darf nicht größer als Gelber Schwellwert sein"
                                   FontSize="10" Foreground="#999" FontStyle="Italic" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- ReadProperty Yellow Threshold -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="🟡 Schwellwert OK" FontWeight="Bold" Foreground="#FFC107"/>
                            <TextBlock Text="Maximal für OK-Status" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Slider Grid.Column="1" Grid.Row="0"
                                x:Name="ReadPropertyYellowThresholdSlider"
                                Minimum="0" Maximum="100"
                                Value="30"
                                VerticalAlignment="Center"
                                Margin="15,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   x:Name="ReadPropertyYellowThresholdValueLabel"
                                   Text="30"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFC107"
                                   TextAlignment="Right"/>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                   Text="Schwellwert muss größer als Grüner Schwellwert sein und darf nicht größer als Roter Schwellwert sein"
                                   FontSize="10" Foreground="#999" FontStyle="Italic" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- ReadProperty Red Threshold -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="🟠 Schwellwert Schlecht" FontWeight="Bold" Foreground="#FF9800"/>
                            <TextBlock Text="Maximal für Schlecht-Status" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Slider Grid.Column="1" Grid.Row="0"
                                x:Name="ReadPropertyRedThresholdSlider"
                                Minimum="0" Maximum="200"
                                Value="60"
                                VerticalAlignment="Center"
                                Margin="15,0"/>

                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   x:Name="ReadPropertyRedThresholdValueLabel"
                                   Text="60"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FF9800"
                                   TextAlignment="Right"/>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                   Text="Schwellwert muss größer als Gelber Schwellwert sein"
                                   FontSize="10" Foreground="#999" FontStyle="Italic" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>
